# Required for the automatic Instagram feed. Keep the access token private.
INSTAGRAM_USER_ID=your_instagram_professional_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# Optional. The app defaults to v25.0.
INSTAGRAM_API_VERSION=v25.0

# Server-only Visual Crossing Weather API credential. Never expose this with NEXT_PUBLIC_.
VISUAL_CROSSING_API_KEY=your_visual_crossing_api_key
