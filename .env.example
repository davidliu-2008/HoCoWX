# Server-only Visual Crossing Weather API credential. Never expose this with NEXT_PUBLIC_.
VISUAL_CROSSING_API_KEY=your_visual_crossing_api_key

# Optional server-only archive for versioned impact predictions and outcomes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
IMPACT_ADMIN_SECRET=use_a_long_random_secret
