# Required for the automatic Instagram feed. Keep the access token private.
INSTAGRAM_USER_ID=your_instagram_professional_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# Optional. The app defaults to v25.0.
INSTAGRAM_API_VERSION=v25.0

# Required for the daily weather briefing archive. Keep the service role key private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Used by Vercel to protect the automatic daily archive endpoint.
CRON_SECRET=replace_with_a_long_random_secret
